{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["Adopter", "Pet Lister"] },
        "address": { "type": "string", "maxLength": 200 },
        "housingType": { "type": "string", "maxLength": 50 },
        "petExperience": { "type": "string", "maxLength": 500 }
      },
      "required": ["email", "role"]
    },
    "MedicalInfo": {
      "title": "MedicalInfo",
      "description": "Health info for a pet",
      "type": "object",
      "properties": {
        "vaccinated": { "type": "boolean" },
        "spayedNeutered": { "type": "boolean" },
        "microchipped": { "type": "boolean" },
        "healthNotes": { "type": "string", "maxLength": 500 }
      },
      "required": ["vaccinated", "spayedNeutered", "microchipped"]
    },
    "Pet": {
      "title": "Pet",
      "description": "A pet available for adoption",
      "type": "object",
      "properties": {
        "petListerId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "animalType": { "type": "string", "enum": ["Dog", "Cat", "Rabbit", "Bird", "Other"] },
        "breed": { "type": "string", "maxLength": 100 },
        "age": { "type": "string", "maxLength": 50 },
        "ageCategory": { "type": "string", "enum": ["Young", "Adult", "Senior"] },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "weight": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "personality": { "type": "array" },
        "goodWith": { "type": "array" },
        "medicalInfo": { "$ref": "#/entities/MedicalInfo" },
        "activityLevel": { "type": "string", "maxLength": 50 },
        "adoptionFee": { "type": "string", "maxLength": 50 },
        "shelterName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["AVAILABLE", "CURRENTLY UNAVAILABLE", "ADOPTED", "PENDING"] },
        "image": { "type": "string", "maxLength": 1000 },
        "dateAdded": { "type": "string", "maxLength": 50 }
      },
      "required": ["petListerId", "name", "animalType", "status"]
    },
    "AdoptionApplication": {
      "title": "AdoptionApplication",
      "description": "Application submitted by an adopter",
      "type": "object",
      "properties": {
        "petId": { "type": "string", "maxLength": 128 },
        "petListerId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "petName": { "type": "string", "maxLength": 100 },
        "petBreed": { "type": "string", "maxLength": 100 },
        "petImage": { "type": "string", "maxLength": 1000 },
        "petType": { "type": "string", "maxLength": 50 },
        "petLocation": { "type": "string", "maxLength": 100 },
        "applicantName": { "type": "string", "maxLength": 100 },
        "applicantEmail": { "type": "string", "maxLength": 100 },
        "applicantPhone": { "type": "string", "maxLength": 20 },
        "applicantAddress": { "type": "string", "maxLength": 200 },
        "housingType": { "type": "string", "maxLength": 50 },
        "hasOtherPets": { "type": "boolean" },
        "petExperience": { "type": "string", "maxLength": 50 },
        "fitReason": { "type": "string", "maxLength": 2000 },
        "dateApplied": { "type": "string", "maxLength": 50 },
        "eligibilityResult": { "type": "string", "maxLength": 50 },
        "ineligibilityReason": { "type": "string", "maxLength": 500 },
        "currentStatus": { "type": "string", "enum": ["Pending", "Under Review", "Approved", "Adopted", "Rejected"] }
      },
      "required": ["petId", "userId", "applicantEmail", "currentStatus"]
    },
    "Like": {
      "title": "Like",
      "description": "A pet liked by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "petId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "petId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profiles"
    },
    "pets/{petId}": {
      "schema": "#/entities/Pet",
      "description": "Pets available for adoption"
    },
    "applications/{applicationId}": {
      "schema": "#/entities/AdoptionApplication",
      "description": "Adoption applications"
    },
    "likes/{likeId}": {
      "schema": "#/entities/Like",
      "description": "User pet likes"
    }
  }
}
